# ==========================================
# SJ STUDIO / SJ KICKS Environment Config
# ==========================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (Never place service-role key in frontend!)
VITE_SUPABASE_ANON_KEY=

# Note: The application is designed to function completely even without
# Supabase credentials by using a resilient in-memory & local-storage catalog
# with instant demo customer & admin accounts.
